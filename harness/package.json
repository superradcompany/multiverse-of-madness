{
  "name": "@multiverse/gameplay-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless, adapter-driven gameplay experiments and learning orchestration",
  "engines": { "node": ">=24" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./node": { "types": "./dist/node/index.d.ts", "import": "./dist/node/index.js" }
  },
  "files": ["dist", "README.md", "ADAPTERS.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.portable.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "check:package": "node scripts/check-package.ts",
    "prepack": "npm run build"
  },
  "devDependencies": { "@types/node": "22.20.3", "tsx": "4.23.13", "typescript": "7.0.2" }
}
