TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# game-aware uses map observations and motor assistance; baseline reproduces the original controller.
JEV_PROFILE=game-aware
# Host-only. Never copy this file into a sandbox.
PORT=4317

# Discarded recording cache only. Selected paths are retained until restart.
RECORDING_MAX_MB=1024
RECORDING_MAX_HOURS=24
RECORDING_MAX_WORLDS=200
